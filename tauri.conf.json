{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiPi Heater Upper",
  "version": "0.4.0",
  "identifier": "com.aipi.heater-upper",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AiPi 加热台 BLE 上位机",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "url": "index.html",
        "additionalBrowserArgs": "--enable-features=WebBluetooth"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' https://api.github.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "resources": {
      "resources/WebView2Loader.dll": "."
    },
    "category": "Utility",
    "shortDescription": "AiPi 加热台 BLE 上位机",
    "longDescription": "BLE upper computer for AiPi heating platform controller",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "template": "windows/main.wxs"
      }
    }
  }
}
